# EVM-V3 - Minimal Configuration

# Required: Discord bot
DISCORD_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN_HERE
MAIN_ADMIN_ID=YOUR_DISCORD_USER_ID
BOT_PREFIX=1

# Proxmox host
YOUR_SERVER_IP=YOUR_SERVER_PUBLIC_IP
PROXMOX_WEB_URL=https://YOUR_SERVER_IP:8006
DEFAULT_STORAGE_POOL=local-lvm

# VPS deployment
VPS_USER_ROLE_ID=YOUR_DISCORD_ROLE_ID
DEPLOY_ROLE_ID=YOUR_DISCORD_ROLE_ID
DEPLOY_RAM=4
DEPLOY_CPU=2
DEPLOY_DISK=30
VPS_DEPLOY_LIMIT=1
DEFAULT_VPS_EXPIRATION_DAYS=30
VPS_ENABLED=true

# LXC defaults (KVM disabled)
KVM_ENABLED=false
VPS_PRIVILEGED=false
VPS_NESTING=true
VPS_HARDEN_SSH=true

# Disable optional integrations/features
PINGGY_ENABLED=false
PINGGY_AUTO_START=false
KVM_PINGGY_ENABLED=false
WEB_TERMINAL_ENABLED=false
CLOUDFLARE_INSTALL_ENABLED=false
VOXCLOUD_AI_AGENT_ENABLED=false
AUTO_CREATE_SERVER_EMOJIS=false
RESOURCE_AUTOSCALE_ENABLED=false

# Basic host branding
BOT_NAME=EVM-V3
BOT_VERSION=EVM-V3
HOST_PROVIDER_NAME=EVM-V3
HOST_MOTD=Welcome to EVM-V3
